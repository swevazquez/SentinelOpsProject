digraph algorithmic_component {
  graph [rankdir=LR, bgcolor="transparent", pad=0.15, nodesep=0.24, ranksep=0.45];
  node [shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#667085", fontname="Arial", fontsize=10, margin="0.12,0.07"];
  edge [color="#475467", arrowsize=0.7];

  subgraph cluster_training {
    label="Offline model development";
    color="#98a2b3";
    style="rounded";
    dataset [label="NASA C-MAPSS\nFD001"];
    label_rul [label="Validate and\nlabel RUL"];
    split [label="Engine-wise\ntrain/validation split"];
    features [label="Rolling sensor\nfeatures"];
    train [label="Random Forest\ntraining"];
    evaluate [label="MAE and RMSE\nevaluation"];
    artifact [label="Versioned model\nartifact", fillcolor="#ecfdf3", color="#17b26a"];
    dataset -> label_rul -> split -> features -> train -> evaluate -> artifact;
  }

  subgraph cluster_runtime {
    label="SentinelOps runtime scoring";
    color="#98a2b3";
    style="rounded";
    telemetry [label="Processed asset\ntelemetry"];
    transform [label="Matching feature\npipeline"];
    predict [label="Predict remaining\ncycles"];
    map [label="Map RUL to risk\nand priority"];
    store [label="Store traceable\nprediction"];
    present [label="API and\ndashboard", fillcolor="#eff8ff", color="#2e90fa"];
    telemetry -> transform -> predict -> map -> store -> present;
  }

  artifact -> predict;
}
