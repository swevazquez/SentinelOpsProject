# SentinelOps local development environment

PROJECT_NAME=sentinelops
ENVIRONMENT=local

# API
API_HOST=0.0.0.0
API_PORT=8000
SENTINELOPS_WORKFLOW_BACKEND=local

# Database
SENTINELOPS_PERSISTENCE_BACKEND=file
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinelops
POSTGRES_USER=sentinelops
POSTGRES_PASSWORD=sentinelops
DATABASE_URL=postgresql://sentinelops:sentinelops@postgres:5432/sentinelops

# Airflow
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://sentinelops:sentinelops@postgres:5432/sentinelops
AIRFLOW__CORE__LOAD_EXAMPLES=false
SENTINELOPS_PROJECT_ROOT=/opt/airflow
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=sentinelops
AIRFLOW_API_URL=http://127.0.0.1:8080/api/v1
AIRFLOW_API_USERNAME=airflow
AIRFLOW_API_PASSWORD=sentinelops
AIRFLOW_DAG_ID=sentinelops_predictive_maintenance
AIRFLOW_REQUEST_TIMEOUT_SECONDS=15
# Leave empty to use the repeatable held-out RUL demo checkpoint.
SENTINELOPS_AIRFLOW_INPUT_PATH=
SENTINELOPS_AIRFLOW_MODEL_VERSION=1.0.0

# Spark
SPARK_MASTER_URL=local[2]

# Agent / AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AGENT_REQUIRE_APPROVAL=true

# Local data paths
RAW_DATA_DIR=/app/data/raw
PROCESSED_DATA_DIR=/app/data/processed
SAMPLE_DATA_DIR=/app/data/samples
