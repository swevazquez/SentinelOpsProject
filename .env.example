# SentinelOps local development environment

PROJECT_NAME=sentinelops
ENVIRONMENT=local

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinelops
POSTGRES_USER=sentinelops
POSTGRES_PASSWORD=sentinelops
DATABASE_URL=postgresql://sentinelops:sentinelops@postgres:5432/sentinelops

# Airflow
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://sentinelops:sentinelops@postgres:5432/sentinelops
AIRFLOW__CORE__LOAD_EXAMPLES=false
SENTINELOPS_PROJECT_ROOT=/opt/airflow

# Spark
SPARK_MASTER_URL=local[*]

# Agent / AI
OPENAI_API_KEY=
AGENT_REQUIRE_APPROVAL=true

# Local data paths
RAW_DATA_DIR=/app/data/raw
PROCESSED_DATA_DIR=/app/data/processed
SAMPLE_DATA_DIR=/app/data/samples
